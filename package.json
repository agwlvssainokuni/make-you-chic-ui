{
  "name": "make-you-chic-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w sample-app",
    "build": "npm run build -w make-you-chic-ui",
    "sample-app:build": "npm run build -w sample-app",
    "preview": "npm run preview -w sample-app",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint . && eslint .",
    "lint:css": "stylelint \"packages/make-you-chic-ui/src/**/*.css\" \"html-demo/**/*.css\" \"packages/sample-app/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
