{
  "name": "make-you-chic-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "scripts": {
    "dev": "npm run dev -w sample-app",
    "build": "npm run build -w make-you-chic-ui",
    "sample-app:build": "npm run build -w sample-app",
    "preview": "npm run preview -w sample-app",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint . && eslint .",
    "lint:css": "stylelint \"packages/make-you-chic-ui/src/**/*.css\" \"html-demo/**/*.css\" \"packages/sample-app/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
